# Copy this file to .env (same folder) and fill in your values.

# Bot token from @BotFather in Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# Where to send alerts. Run `npm run telegram:chatid` after messaging your bot to find it.
# For several chats, separate with commas. Group ids start with "-".
TELEGRAM_CHAT_ID=

# 1 = also alert when stocks drop out of a scanner. 0 = only new stocks.
TELEGRAM_NOTIFY_DROPPED=0
